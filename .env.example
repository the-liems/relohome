# ============================================
# AI20K Project — Environment Variables
# ============================================
# Run npm run dev:init to create .env.local, then fill in provider keys
# NEVER commit .env.local to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=
# Optional semantic guardrail (server only). Existing OpenRouter sk-or-v1-* key in
# OPENAI_API_KEY can also be used. Both paths require sk-or-v1-* format before HTTP.
# Runtime projection is structured-only (no narrative chat/evidence/name/address text).
# This is not full-intent/grounding/injection enforcement; coverage gaps are metrics.
OPENROUTER_API_KEY=
# off|shadow only. No blocking enforcement until Vietnamese evaluation/review.
AGENT_GUARDRAIL_MODE=off
AGENT_GUARDRAIL_TIMEOUT_S=1.5
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- App Config ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Legacy LangSmith (superseded by Langfuse; see docs/runbooks/observability.md) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Browser application ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Flight MCP server (apps/flights-mcp) ----
# mock = dữ liệu giả lập offline; serpapi = giá thật từ Google Flights (100 lượt/tháng miễn phí)
FLIGHT_SEARCH_PROVIDER=serpapi
FLIGHT_SERPAPI_API_KEY=
FLIGHT_DB_PATH=./data/flights.db
# FLIGHT_SEARCH_CACHE_TTL=3600
# FLIGHT_OFFER_TTL_MINUTES=30
# FLIGHT_HOLD_MINUTES=15
# FLIGHT_MCP_HOST=127.0.0.1
# FLIGHT_MCP_PORT=8765
# Agent connects to a separately running service; provider credentials stay on that service.
FLIGHT_MCP_URL=http://127.0.0.1:8765/mcp
# Required: generate a separate random token for each service (openssl rand -hex 32).
# Server uses MCP_AUTH_TOKEN; local Flight settings also accept this scoped name.
FLIGHT_MCP_AUTH_TOKEN=

# ---- Payment MCP server (apps/payments-mcp) ----
# mock = giả lập offline; zalopay = ZaloPay sandbox (không có tiền thật)
PAYMENT_PROVIDER=zalopay
# Lấy bộ key sandbox tại trang tài liệu ZaloPay; chỉ điền trong .env.local, KHÔNG commit, KHÔNG dán vào chat
PAYMENT_ZALOPAY_APP_ID=
PAYMENT_ZALOPAY_KEY1=
PAYMENT_ZALOPAY_KEY2=
# Tiền tố nhóm trong mã đơn (merchant sandbox dùng chung cho mọi nhóm)
PAYMENT_ORDER_PREFIX=P044
PAYMENT_DB_PATH=./data/payments.db
# PAYMENT_ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2
# PAYMENT_REDIRECT_URL=http://localhost:8502/
# PAYMENT_PSEUDONYM_SALT=          # để trống = tự sinh và lưu trong SQLite
# PAYMENT_EXPIRE_MINUTES=15
# PAYMENT_RETENTION_DAYS=30
# PAYMENT_MCP_HOST=127.0.0.1
# PAYMENT_MCP_PORT=8766
PAYMENT_MCP_URL=http://127.0.0.1:8766/mcp
# Required: must match the Payment server's MCP_AUTH_TOKEN.
PAYMENT_MCP_AUTH_TOKEN=

# Graph-compatible LLM components (wired by relohome_agent.main lifespan)
AGENT_INTAKE_MODEL=gpt-6-luna
# OPENAI_API_KEY accepts an OpenAI key or an OpenRouter sk-or-v1- key; the app
# selects the matching API endpoint and maps Luna to openai/gpt-6-luna.
AGENT_PLANNER_MODEL=gpt-6-luna
AGENT_MOVING_MODEL=gpt-6-luna
AGENT_HOUSING_MODEL=gpt-6-luna
AGENT_MAP_MODEL=gpt-6-luna
AGENT_FLIGHT_MODEL=gpt-6-luna
AGENT_PAYMENT_MODEL=gpt-6-luna

# ---- Agent graph: nối subagent của các service (docs/architecture/agent-graph.md §6.3.7) ----
# fake = FakeAgent + FakeTransaction (mặc định, không cần mạng); live = gọi các service đã cấu hình dưới đây
AGENT_SUBAGENTS=live
# Disable to retain model planning/tool selection for simple housing searches and follow-up filter edits.
AGENT_FILTER_FAST_PATH_ENABLED=true
AGENT_STATE_DIR=data/agent-runtime
# Trusted local frontend/gateway only; never put this secret in browser JavaScript.
AGENT_API_TOKEN=
# Housing owner workspace: trusted account IDs allowed to approve properties/listings.
# Vietmap Search v4 + Place v4; server only. Empty permits drafts, but mapped publication needs a valid key.
VIETMAP_API_KEY=
HOUSING_MODERATOR_IDS=
HOUSING_REVIEW_MIN_COUNT=1
HOUSING_REVIEW_PATTERN_DAYS=90
HOUSING_REVIEW_LOW_STARS=2
HOUSING_REVIEW_PATTERN_PROPERTIES=2
HOUSING_REVIEW_PATTERN_AUTHORS=3
# Optional poster-terms version; empty means no acceptance step (docs/review/host-mode-design.md).
HOST_TERMS_VERSION=
# Messages per minute per sender in a tenant-landlord conversation.
HOUSING_MESSAGE_RATE_PER_MINUTE=10
# Local/staging only: allow recording a scheduled viewing immediately.
# Still requires a booked slot and landlord confirmation for owner-managed homes.
# APP_ENV=production ignores this flag. Configure in Coolify; never use VITE_*.
HOUSING_VIEWING_TEST_VISIT_ANYTIME=false
# Viewing starts: at least 60 minutes from now, every 30 minutes from 08:00.
# DAY_END is inclusive: 22:00 is an allowed appointment start (Asia/Ho_Chi_Minh).
HOUSING_VIEWING_LEAD_MINUTES=60
HOUSING_VIEWING_DAY_END=22:00
# Days ahead a landlord may propose replacement viewing times (1-60).
# Read by both the agent API (slot list) and the platform API (validation).
HOUSING_VIEWING_PROPOSAL_DAYS=7
# Public origin used in owner-uploaded image URLs (for example https://relohome.vn).
# Uploaded files live under Frontend/data/housing-media; mount this path persistently in production.
SIU_PUBLIC_BASE_URL=
AGENT_WRITES_ENABLED=false
AGENT_SANDBOX_PAYMENTS_ENABLED=false
FLIGHT_SIMULATION_ENABLED=false
AGENT_ALLOW_SIMULATED_TRANSACTIONS=false
# Location: housing + place + route (apps/location-mcp)
LOCATION_MCP_URL=http://127.0.0.1:4300/mcp
LOCATION_MCP_AUTH_TOKEN=
# Moving / AhaMove (apps/moving-mcp). Ba secret nội bộ khác nhau, tự sinh, >= 32 ký tự,
# KHÔNG phải key AhaMove: token đọc (subagent), token ghi (chỉ transaction), token ghi approval (backend).
# Không bao giờ đưa token ghi / approval cho LLM. Thiếu token ghi thì graph không đặt / huỷ đơn.
# URL dưới đây dùng khi cùng Docker network; chạy trên host thì dùng 127.0.0.1.
MOVING_MCP_URL=http://127.0.0.1:4400/mcp
MOVING_MCP_AUTH_TOKEN=
MOVING_MCP_WRITE_TOKEN=
MOVING_ENVIRONMENT=staging
MOVING_APPROVAL_URL=http://127.0.0.1:4200/v1/internal/moving/approvals
MOVING_APPROVAL_TOKEN=
# AhaMove bắt buộc tên + SĐT khi báo giá: dùng liên hệ thật của hệ thống (tổng đài), không dùng của người dùng
MOVING_QUOTE_CONTACT_NAME=
MOVING_QUOTE_CONTACT_MOBILE=
# Flight / Payment require the HTTP URLs above; the agent never starts provider processes.
# Nút "giả lập đã thanh toán" cho demo (API /payment/simulate). Chỉ bật khi Payment chạy PAYMENT_PROVIDER=mock
PAYMENT_SIMULATION_ENABLED=false

# ---- Roommate Discovery: backend/API/Agent only; UI release gates are still pending ----
ROOMMATE_ENABLED=false
# Public chat is opt-in; private actions continue to require an account.
# One guest thread, fixed 24-hour lifetime; keep a single gateway worker/replica.
RELOHOME_GUEST_ENABLED=false
RELOHOME_GUEST_TURNS_30M=10
RELOHOME_GUEST_TURNS_DAY=30
RELOHOME_GUEST_IP_TURNS_30M=30
RELOHOME_GUEST_IP_TURNS_DAY=100
RELOHOME_GUEST_GLOBAL_TURNS_DAY=300
RELOHOME_GUEST_REQUESTS_MINUTE=120
# Private single-host state, never place this under data/, Frontend/public/, apps/web/public/, or apps/web/dist/.
ROOMMATE_STATE_DIR=logs/private-roommate
ROOMMATE_STORAGE=sqlite
# Optional cloud Roommate storage on the existing PostgreSQL cluster:
# ROOMMATE_DATABASE_URL=postgresql://dedicated-roommate-role@private-host/existing-database
ROOMMATE_DATABASE_SCHEMA=roommate
ROOMMATE_DATABASE_POOL_SIZE=8
# In-app Roommate messages are retained for up to this many days (1-3650).
# Connection acceptance does not share Phone/Zalo or expire after the legacy contact grant.
ROOMMATE_CHAT_RETENTION_DAYS=180
# ROOMMATE_CONTACT_KEY=<stable Fernet secret; use the original key when migrating>
# Housing Admin IDs (HOUSING_MODERATOR_IDS above) also moderate Roommate.
# Optional additional Roommate-only account IDs; leave empty when using Housing Admin.
# At least one ID in either server-side list is required when Roommate is enabled.
ROOMMATE_MODERATORS=
# Optional server-exported canonical area ID -> city JSON; absent = whole-city choices only.
# ROOMMATE_AREA_CATALOG=config/roommate-areas.json
# Uses AGENT_API_TOKEN above in both API and trusted gateway; never expose it to JavaScript.
# Optional FOSSGIS public driving routing for browser device directions only.
# Unset uses this approved endpoint; explicitly empty disables public routing.
# UI discloses coordinate sharing before requesting GPS; no extra checkbox.
# Demo use only: provider logs requests; max 1 request/sec per local process.
OSRM_PUBLIC_DRIVING_URL=https://routing.openstreetmap.de/routed-car/

# Optional telemetry; see docs/runbooks/observability.md.
OTEL_DEPLOYMENT_ENVIRONMENT=staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SEMCONV_STABILITY_OPT_IN=http
OTEL_RESOURCE_ATTRIBUTES=service.namespace=relohome

# Installed Python apps: absolute existing checkout/deployment root. Root npm/Make commands set this.
# RELOHOME_RUNTIME_ROOT=/absolute/path/to/P-044

# ---- Local Location / Moving services and database ----
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=lifeflow
POSTGRES_ADMIN_USER=lifeflow_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=lifeflow_app
POSTGRES_APP_PASSWORD=
POSTGRES_INGEST_USER=lifeflow_ingest
POSTGRES_INGEST_PASSWORD=
POSTGRES_PORT=5433
PLATFORM_API_HOST=127.0.0.1
PLATFORM_API_PORT=4100
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST=127.0.0.1
MCP_PORT=4300
MCP_IMAGE_TAG=0.1.0
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],lifeflow-location-mcp
MCP_ALLOWED_ORIGIN_HOSTS=localhost,127.0.0.1,[::1]
OSRM_HCM_URL=http://127.0.0.1:5000
OSRM_HANOI_URL=http://127.0.0.1:5001
OSRM_DANANG_URL=http://127.0.0.1:5002
OSRM_HCM_WALKING_URL=http://127.0.0.1:5010
OSRM_HANOI_WALKING_URL=http://127.0.0.1:5011
OSRM_DANANG_WALKING_URL=http://127.0.0.1:5012
OSRM_HCM_MOTORCYCLE_URL=http://127.0.0.1:5020
OSRM_HANOI_MOTORCYCLE_URL=http://127.0.0.1:5021
OSRM_DANANG_MOTORCYCLE_URL=http://127.0.0.1:5022
COMMUTE_CANDIDATE_LIMIT=100
AHAMOVE_ENV=staging
AHAMOVE_BASE_URL=https://partner-apistg.ahamove.com/v3
AHAMOVE_API_KEY=
AHAMOVE_MOBILE=
AHAMOVE_USER_TOKEN=
AHAMOVE_TIMEOUT_MS=10000
AHAMOVE_QUOTE_TTL_SECONDS=300
AHAMOVE_WRITE_ENABLED=false
AHAMOVE_RATING_ENABLED=false
AHAMOVE_PRODUCTION_ENABLED=false
AHAMOVE_WEBHOOK_AUTH_MODE=api-key
AHAMOVE_WEBHOOK_SECRET=
MOVING_API_HOST=127.0.0.1
MOVING_API_PORT=4200
MOVING_DB_ADMIN_PASSWORD=
MOVING_DB_APP_PASSWORD=
MOVING_MCP_HOST=127.0.0.1
MOVING_MCP_PORT=4400
MOVING_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,moving-mcp
MOVING_MCP_ALLOWED_ORIGINS=
# MOVING_DATABASE_URL=  # Optional remote DB override.
# MOVING_DATABASE_ADMIN_URL=  # Optional remote DB override.
# POI_SOURCE_PATH=  # Set an absolute path when running importers.
# BOUNDARY_SOURCE_DIR=  # Set an absolute path when running importers.
# ADMIN_AREA_SOURCE_PATH=  # Set an absolute path when running importers.
# OSM_PBF_PATH=  # Set an absolute path when running importers.
# POI_V2_SOURCE_PATH=  # Set an absolute path when running importers.
OSM_SOURCE_VERSION=vietnam-260922
HOUSING_SOURCE_PATH=../Data/housing_clean_2026-09-26.jsonl
HOUSING_SOURCE_VERSION=housing-clean-2026-09-26

FLIGHT_MCP_PORT=8765
PAYMENT_MCP_PORT=8766

# Native Moving uses POSTGRES_* unless MOVING_DATABASE_URL is set.
# MOVING_DATABASE_ADMIN_URL is required for a separate Moving migration job.
MOVING_DB_APP_USER=moving_app

# Vite dev proxy; used by apps/web/vite.config.ts, never exposed as a browser variable.
SIU_GATEWAY_URL=http://127.0.0.1:8503

# Optional full Location connection URLs (e.g. a remote database with sslmode).
# Empty values keep the POSTGRES_* settings above.
LOCATION_DATABASE_URL=
LOCATION_ADMIN_DATABASE_URL=
LOCATION_INGEST_DATABASE_URL=

# LangGraph + OpenAI tracing directly to your Langfuse server.
# Enable after configuring the server URL and project keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://langfuse.example.com
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_MEDIA_UPLOAD_ENABLED=false

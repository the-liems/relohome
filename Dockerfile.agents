# syntax=docker/dockerfile:1.14
FROM python:3.11-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV RELOHOME_RUNTIME_ROOT=/app
WORKDIR /app
COPY requirements-agents.txt ./
COPY packages/python/agent-services/ ./packages/python/agent-services/
COPY src/agent_services/ ./src/agent_services/
RUN pip install --no-cache-dir -r requirements-agents.txt \
    && useradd --uid 10001 --create-home appuser \
    && mkdir /app/data && chown appuser:appuser /app/data
COPY --chmod=u=rwX,go=rX src/__init__.py ./src/__init__.py
COPY --chmod=u=rwX,go=rX src/agent_services ./src/agent_services
COPY --chmod=u=rwX,go=rX config/agent-services ./config/agent-services
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"

FROM runtime AS intake
CMD ["uvicorn", "src.agent_services.intake.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]

FROM runtime AS orchestrator
CMD ["uvicorn", "src.agent_services.orchestrator.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]

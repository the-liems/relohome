{
  "description": "Ghi prompt Codex vào AI usage log của project.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "commandWindows": "py -3 scripts/log_hook.py --tool=codex",
            "statusMessage": "Đang ghi AI usage log",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "commandWindows": "py -3 scripts/log_hook.py --tool=codex",
            "statusMessage": "Đang hoàn tất AI usage log",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

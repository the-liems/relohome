{
  "uid": "relohome-overview",
  "title": "ReloHome operations",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "relohome"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "staging,production",
        "current": {
          "text": "staging",
          "value": "staging"
        },
        "options": [
          {
            "text": "staging",
            "value": "staging",
            "selected": true
          },
          {
            "text": "production",
            "value": "production",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cortex"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{deployment_environment_name=\"$environment\"}[5m]))",
          "legendFormat": "{{service_name}} {{kind}} {{outcome}} {{model}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cortex"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{deployment_environment_name=\"$environment\",http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service_name}} {{kind}} {{outcome}} {{model}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 3,
      "title": "Request p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cortex"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,service_name) (rate(http_server_request_duration_seconds_bucket{deployment_environment_name=\"$environment\"}[5m])))",
          "legendFormat": "{{service_name}} {{kind}} {{outcome}} {{model}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 8,
      "title": "Collector queues",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cortex"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size{deployment_environment_name=\"$environment\"}",
          "legendFormat": "{{service_name}} {{kind}} {{outcome}} {{model}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 9,
      "title": "Collector memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cortex"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_process_memory_rss{deployment_environment_name=\"$environment\"}",
          "legendFormat": "{{service_name}} {{kind}} {{outcome}} {{model}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 20,
      "title": "Operational logs \u2014 trace_id links to Tempo and Langfuse",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{deployment_environment_name=\"$environment\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true
      }
    }
  ]
}

# Copy outside the repository and replace ALL placeholders; never commit a real .env.
# Database URL passwords should be random hexadecimal values (no URL escaping required).
LF_POSTGRES_PASSWORD=replace-with-random-hex
LF_CLICKHOUSE_PASSWORD=replace-with-random-hex
LF_REDIS_PASSWORD=replace-with-random-hex
LF_SALT=replace-with-random-hex
LF_ENCRYPTION_KEY=replace-with-64-hex-characters
LF_NEXTAUTH_SECRET=replace-with-random-hex
# Existing private S3-compatible bucket; no object-storage server is deployed.
# Enter the access key and secret in Coolify's secret fields.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=replace-with-existing-bucket
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=https://replace-with-s3-api-endpoint
# Use the bucket's region (e.g. ap-southeast-1); Cloudflare R2 uses auto.
LANGFUSE_S3_EVENT_UPLOAD_REGION=replace-with-bucket-region
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=replace-with-bucket-access-key
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace-with-bucket-secret-key
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
# Set true only when your S3-compatible provider requires path-style requests.
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=false
# Apply an 8-day expiration rule for the configured prefix at the storage provider.
OBS_ADMIN_EMAIL=operator@example.com
OBS_ADMIN_PASSWORD=replace-with-random-password
# Retain the existing organization ID when upgrading a previously initialized deployment.
LANGFUSE_INIT_ORG_ID=relohome
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-password
LANGFUSE_URL=http://localhost:3000
GRAFANA_URL=http://localhost:3001
# Configure optional contact points and notification policies later in Grafana.
# Langfuse creates the "relohome" project with this key pair at first start.
# Set the same pair on every Collector. Generate with: echo pk-lf-$(openssl rand -hex 16)
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-random-hex
LANGFUSE_SECRET_KEY=sk-lf-replace-with-random-hex
# Use the same ingestion network name on the platform and every Collector resource.
OBSERVABILITY_INGEST_NETWORK=relohome-observability-ingest

# Collector resource: one per environment, plus the Langfuse key pair above.
OTEL_DEPLOYMENT_ENVIRONMENT=staging
APPLICATION_NETWORK=replace-with-existing-application-docker-network

# Use separate existing buckets for Loki and Cortex. Their compactors manage retention.
# Endpoints are host[:port] without a scheme; INSECURE=true selects HTTP for local fixtures.
# Do not apply the Langfuse events lifecycle to these buckets.
LOKI_S3_BUCKET=your-loki-bucket
LOKI_S3_ENDPOINT=s3.your-region.amazonaws.com
LOKI_S3_REGION=your-region
LOKI_S3_ACCESS_KEY_ID=replace-me
LOKI_S3_SECRET_ACCESS_KEY=replace-me
LOKI_S3_INSECURE=false
LOKI_S3_FORCE_PATH_STYLE=false
CORTEX_S3_BUCKET=your-cortex-bucket
CORTEX_S3_ENDPOINT=s3.your-region.amazonaws.com
CORTEX_S3_REGION=your-region
CORTEX_S3_ACCESS_KEY_ID=replace-me
CORTEX_S3_SECRET_ACCESS_KEY=replace-me
CORTEX_S3_INSECURE=false
# auto, virtual-hosted, or path; use path for providers requiring path-style access.
CORTEX_S3_BUCKET_LOOKUP_TYPE=auto

# Copy outside the repository and replace ALL placeholders; never commit a real .env.
# Database URL passwords should be random hexadecimal values (no URL escaping required).
LF_POSTGRES_PASSWORD=replace-with-random-hex
LF_CLICKHOUSE_PASSWORD=replace-with-random-hex
LF_REDIS_PASSWORD=replace-with-random-hex
LF_SALT=replace-with-random-hex
LF_ENCRYPTION_KEY=replace-with-64-hex-characters
LF_NEXTAUTH_SECRET=replace-with-random-hex
MINIO_ROOT_USER=replace-with-generated-username
MINIO_ROOT_PASSWORD=replace-with-random-hex
OBS_ADMIN_EMAIL=operator@example.com
OBS_ADMIN_PASSWORD=replace-with-random-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-password
LANGFUSE_URL=http://localhost:3000
GRAFANA_URL=http://localhost:3001
# This secret is passed only to Grafana. Configure contact points/rules in Grafana.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-webhook
# Generate independently; Caddy stores bcrypt hashes, collectors hold the plaintext passwords.
STAGING_INGEST_PASSWORD_HASH=replace-with-caddy-bcrypt-hash
PRODUCTION_INGEST_PASSWORD_HASH=replace-with-different-caddy-bcrypt-hash
# Create two projects in Langfuse after its first start; base64(public-key:secret-key).
LANGFUSE_STAGING_AUTH=
LANGFUSE_PRODUCTION_AUTH=
LANGFUSE_STAGING_PROJECT_ID=lifeflow-staging
LANGFUSE_PRODUCTION_PROJECT_ID=lifeflow-production
OBSERVABILITY_ENVIRONMENTS=staging

# Collector resource: use one separate environment file per environment.
OTEL_DEPLOYMENT_ENVIRONMENT=staging
APPLICATION_NETWORK=replace-with-existing-application-docker-network
OTEL_COLLECTOR_TOKEN=replace-with-random-hex
OBSERVABILITY_INGEST_PASSWORD=replace-with-matching-environment-password
OBSERVABILITY_GATEWAY_URL=http://telemetry-gateway:8080

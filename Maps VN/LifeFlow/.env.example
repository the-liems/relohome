POSTGRES_DB=lifeflow
POSTGRES_ADMIN_USER=lifeflow_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-local-password
POSTGRES_APP_USER=lifeflow_app
POSTGRES_APP_PASSWORD=replace-with-a-different-strong-password
POSTGRES_INGEST_USER=lifeflow_ingest
POSTGRES_INGEST_PASSWORD=replace-with-a-third-strong-password
POSTGRES_PORT=5433
PLATFORM_API_HOST=127.0.0.1
PLATFORM_API_PORT=4100
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_IMAGE_TAG=0.1.0
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],lifeflow-location-mcp
MCP_ALLOWED_ORIGIN_HOSTS=localhost,127.0.0.1,[::1]
MCP_AUTH_TOKEN=
OSRM_HCM_URL=http://127.0.0.1:5000
OSRM_HANOI_URL=http://127.0.0.1:5001
OSRM_DANANG_URL=http://127.0.0.1:5002
OSRM_HCM_WALKING_URL=http://127.0.0.1:5010
OSRM_HANOI_WALKING_URL=http://127.0.0.1:5011
OSRM_DANANG_WALKING_URL=http://127.0.0.1:5012
OSRM_HCM_MOTORCYCLE_URL=http://127.0.0.1:5020
OSRM_HANOI_MOTORCYCLE_URL=http://127.0.0.1:5021
OSRM_DANANG_MOTORCYCLE_URL=http://127.0.0.1:5022
COMMUTE_CANDIDATE_LIMIT=100

# AhaMove v3 - use a newly rotated credential; never commit real values.
AHAMOVE_ENV=staging
AHAMOVE_BASE_URL=https://partner-apistg.ahamove.com/v3
AHAMOVE_API_KEY=replace-with-staging-api-key
AHAMOVE_MOBILE=replace-with-registered-mobile
# Prefer a token when available. Leave blank to obtain it from API key + mobile.
AHAMOVE_USER_TOKEN=
AHAMOVE_TIMEOUT_MS=10000
AHAMOVE_QUOTE_TTL_SECONDS=300
AHAMOVE_WRITE_ENABLED=false
AHAMOVE_RATING_ENABLED=false
AHAMOVE_PRODUCTION_ENABLED=false
AHAMOVE_WEBHOOK_AUTH_MODE=api-key
AHAMOVE_WEBHOOK_SECRET=replace-with-webhook-secret
MOVING_API_HOST=127.0.0.1
MOVING_API_PORT=4200
# Independent Moving containers (local Compose passwords must be URL-safe, e.g. hex).
# Generate each secret independently; none of these values are AhaMove credentials.
MOVING_DB_ADMIN_PASSWORD=
MOVING_DB_APP_PASSWORD=
MOVING_MCP_AUTH_TOKEN=
MOVING_MCP_HOST=127.0.0.1
MOVING_MCP_PORT=4400
MOVING_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,moving-mcp
MOVING_MCP_ALLOWED_ORIGINS=
# For native/deployed execution; Moving-specific URL takes precedence over DATABASE_URL.
MOVING_DATABASE_URL=
# Supply only to the one-off migration job, never to runtime containers.
MOVING_DATABASE_ADMIN_URL=
POI_SOURCE_PATH=D:/Demo AI thực chiến/Maps VN/Extracts/accommodations.geojson
BOUNDARY_SOURCE_DIR=D:/Demo AI thực chiến/Maps VN/Cities/boundaries
ADMIN_AREA_SOURCE_PATH=D:/Demo AI thực chiến/Maps VN/LifeFlow/data/administrative/vietnam-admin.geojsonseq
OSM_PBF_PATH=D:/Demo AI thực chiến/Maps VN/Raw/vietnam-260922.osm.pbf
POI_V2_SOURCE_PATH=D:/Demo AI thực chiến/Maps VN/Extracts/POI/vietnam-260922/vietnam-pois-v2.geojsonseq
OSM_SOURCE_VERSION=vietnam-260922
HOUSING_SOURCE_PATH=../Data/housing_clean_2026-09-26.jsonl
HOUSING_SOURCE_VERSION=housing-clean-2026-09-26

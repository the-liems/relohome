{
  "private": true,
  "type": "module",
  "scripts": {
    "build:moving": "npm --prefix ../.. run build:moving --",
    "moving:up": "npm run build:moving && node ../../scripts/dev.mjs moving-stack -- node scripts/moving-stack.mjs up",
    "moving:down": "node ../../scripts/dev.mjs moving-stack -- node scripts/moving-stack.mjs down",
    "moving:status": "node ../../scripts/dev.mjs moving-stack -- node scripts/moving-stack.mjs status",
    "moving:verify": "node ../../scripts/dev.mjs moving-stack -- node scripts/moving-stack.mjs verify",
    "build": "npm --prefix ../.. run build:ts --",
    "test": "npm --prefix ../.. run test:integration --",
    "test:ci": "npm --prefix ../.. run test:ci --",
    "db:up": "node ../../scripts/dev.mjs database -- docker compose -f infra/compose.yaml up -d postgis",
    "db:stop": "node ../../scripts/dev.mjs database -- docker compose -f infra/compose.yaml stop postgis",
    "db:migrate": "npm --prefix ../.. run db:migrate --workspace @lifeflow/platform-api --",
    "mcp:up": "node ../../scripts/dev.mjs database -- docker compose -f infra/compose.yaml up -d --build location-mcp",
    "mcp:stop": "node ../../scripts/dev.mjs database -- docker compose -f infra/compose.yaml stop location-mcp",
    "db:import:places": "npm --prefix ../.. run db:import:places --workspace @lifeflow/platform-api --",
    "db:import:pois:v2": "npm --prefix ../.. run db:import:pois:v2 --workspace @lifeflow/platform-api --",
    "db:import:housing": "npm --prefix ../.. run db:import:housing --workspace @lifeflow/platform-api --",
    "db:report:pois": "npm --prefix ../.. run db:report:pois --workspace @lifeflow/platform-api --",
    "db:deduplicate:pois": "npm --prefix ../.. run db:deduplicate:pois --workspace @lifeflow/platform-api --",
    "db:import:areas": "npm --prefix ../.. run db:import:areas --workspace @lifeflow/platform-api --",
    "dev:api": "npm --prefix ../.. run dev:api --",
    "dev:mcp": "npm --prefix ../.. run dev:mcp --",
    "dev:mcp:http": "npm --prefix ../.. run dev:mcp:http --",
    "dev:moving-api": "npm --prefix ../.. run dev:moving-api --",
    "dev:moving-mcp": "npm --prefix ../.. run dev:moving-mcp --",
    "dev:moving-mcp:http": "npm --prefix ../.. run dev:moving-mcp:http --",
    "db:migrate:moving": "node ../../scripts/dev.mjs moving-migration -- node packages/moving-service/dist/migrate.js",
    "test:moving:http": "npm --prefix ../.. run test:http --workspace @lifeflow/moving-mcp-server",
    "test:moving:native": "node scripts/test-moving-native.mjs",
    "test:moving:deployment": "node ../../scripts/dev.mjs moving-stack -- node scripts/verify-moving-deployment.mjs",
    "test:moving:live": "npm --prefix ../.. run test:live --workspace @lifeflow/moving-service && npm --prefix ../.. run test:live --workspace @lifeflow/moving-mcp-server",
    "dev:map": "npm --prefix ../.. run dev:map --"
  },
  "engines": {
    "node": ">=24"
  }
}

{
  "name": "@lifeflow/moving-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node ../../../scripts/dev.mjs moving -- tsx src/server.ts",
    "start": "node dist/server.js",
    "dev:http": "node ../../../scripts/dev.mjs moving -- tsx src/http-server.ts",
    "start:http": "node dist/http-server.js",
    "test:http": "node ../../../scripts/dev.mjs moving -- vitest run tests/http.live.test.ts",
    "test": "vitest run tests --passWithNoTests",
    "test:live": "node ../../../scripts/dev.mjs moving -- vitest run tests/live.staging.test.ts"
  },
  "dependencies": {
    "@lifeflow/contracts": "0.1.0",
    "@lifeflow/mcp-core": "0.1.0",
    "@lifeflow/moving-service": "0.1.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  }
}

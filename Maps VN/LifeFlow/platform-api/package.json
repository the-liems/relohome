{
  "name": "@lifeflow/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node ../../../scripts/dev.mjs platform -- tsx src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "node ../../../scripts/dev.mjs migration -- tsx src/migrate.ts",
    "db:import:places": "node ../../../scripts/dev.mjs migration -- tsx src/import-places.ts",
    "db:import:pois:v2": "node ../../../scripts/dev.mjs migration -- tsx src/import-pois-v2.ts",
    "db:import:housing": "node ../../../scripts/dev.mjs migration -- tsx src/import-housing.ts",
    "db:report:pois": "node ../../../scripts/dev.mjs migration -- tsx src/report-poi-coverage.ts",
    "db:deduplicate:pois": "node ../../../scripts/dev.mjs migration -- tsx src/deduplicate-pois.ts",
    "db:import:areas": "node ../../../scripts/dev.mjs migration -- tsx src/import-admin-areas.ts",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@lifeflow/contracts": "0.1.0",
    "@lifeflow/housing-query": "0.1.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  }
}

# Large OSM and OSRM datasets are kept outside Git
*.osm.pbf
*.osrm*
*.pbf
*.geojson
*.geojsonseq

# Map data retained for city-boundary ingestion and legacy map tests
!Maps\ VN/Cities/boundaries/*.geojson
!examples/map-app/public/data/
!examples/map-app/public/data/*.geojson

# DVC keeps pointers in Git; all raw and generated map bytes stay outside Git.
Maps\ VN/Raw/**
Maps\ VN/Extracts/**
Maps\ VN/Routing/**
!Maps\ VN/Raw/**/
!Maps\ VN/Extracts/**/
!Maps\ VN/Routing/**/
!Maps\ VN/Raw/**/*.dvc
!Maps\ VN/Extracts/**/*.dvc
!Maps\ VN/Routing/**/*.dvc
!Maps\ VN/Raw/**/.gitignore
!Maps\ VN/Extracts/**/.gitignore
!Maps\ VN/Routing/**/.gitignore

# Local pytest/tool scratch directories (never commit generated keys)
.tmp/

# Python build artifacts
**/build/
**/*.egg-info/

# Canonical TypeScript workspaces (#111)
apps/*/dist/
packages/*/dist/

# Relocated location source; persistent legacy state remains above.

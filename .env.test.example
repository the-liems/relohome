# Copy to .env.test (ignored). Vendor credentials and operator inputs for opt-in live
# tests only; unit tests never read this file. One literal KEY=VALUE per line: no
# quotes, `export` or ${VAR}. The running stack is passed to pytest as options instead
# (--live-api-token, --location-mcp-token, ...); see docs/runbooks/local-mvp.md.

# LLM provider
OPENAI_API_KEY=
# Optional model overrides for live LLM tests
AGENT_INTAKE_MODEL=
AGENT_PLANNER_MODEL=
AGENT_HOUSING_MODEL=
AGENT_MOVING_MODEL=

# AhaMove staging: AHAMOVE_USER_TOKEN, or AHAMOVE_API_KEY with AHAMOVE_MOBILE
AHAMOVE_USER_TOKEN=
AHAMOVE_API_KEY=
AHAMOVE_MOBILE=

# Operator-approved real route and contact (JSON values on one line)
MOVING_LIVE_QUOTE_INPUTS=
MOVING_FORM_LIVE_INPUTS=
MOVING_QUOTE_CONTACT_NAME=
MOVING_QUOTE_CONTACT_MOBILE=

# AhaMove staging estimate scenario (TypeScript live tests)
AHAMOVE_TEST_SERVICE_ID=
AHAMOVE_TEST_CITY_ID=
AHAMOVE_TEST_PICKUP_ADDRESS=
AHAMOVE_TEST_PICKUP_LAT=
AHAMOVE_TEST_PICKUP_LNG=
AHAMOVE_TEST_PICKUP_NAME=
AHAMOVE_TEST_PICKUP_MOBILE=
AHAMOVE_TEST_DESTINATION_ADDRESS=
AHAMOVE_TEST_DESTINATION_LAT=
AHAMOVE_TEST_DESTINATION_LNG=
AHAMOVE_TEST_DESTINATION_NAME=
AHAMOVE_TEST_DESTINATION_MOBILE=
AHAMOVE_TEST_TRACKING_NUMBER=
AHAMOVE_TEST_PAYMENT_METHOD=
